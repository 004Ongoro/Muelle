---
import CoreCard from "@/components/ui/CoreCard.astro";
import PipelineNode from "@/components/ui/PipelineNode.astro";
import type { PipelineCore, PipelineStep } from "@/data/pipeline";

interface Props {
  inputs: PipelineStep[];
  outputs: PipelineStep[];
  core: PipelineCore;
}

const { inputs, outputs, core } = Astro.props;
---

<div
  class="pipe grid items-center gap-4 rounded-[22px] border border-line bg-card p-4 min-[900px]:grid-cols-[1fr_1.25fr_1fr] min-[900px]:gap-12 min-[900px]:p-10"
>
  <div class="flex flex-col gap-3.5">
    {inputs.map((step) => <PipelineNode step={step} direction="in" />)}
  </div>

  <CoreCard core={core} />

  <div class="flex flex-col gap-3.5">
    {outputs.map((step) => <PipelineNode step={step} direction="out" />)}
  </div>
</div>
