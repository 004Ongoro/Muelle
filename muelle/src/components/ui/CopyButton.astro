---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  value: string;
}

const { value } = Astro.props;
---

<button type="button" class="cp" data-copy={value} aria-label="Copy command">
  <Icon name="copy" size={14} class="icon-copy" />
  <Icon name="check" size={14} class="icon-check hidden" />
  <span class="sr-only" role="status" data-copy-label>Copy command</span>
</button>
