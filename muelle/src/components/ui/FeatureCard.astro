---
interface Props {
  label: string;
  title: string;
  body: string;
  /** Two columns wide on the desktop grid. */
  wide?: boolean;
  /** Tilts the child slab towards the pointer. */
  tilt?: boolean;
  class?: string;
}

const { label, title, body, wide = false, tilt = false, class: className } = Astro.props;
---

<article
  class:list={["bento-card", wide && "bento-card--wide", className]}
  data-spotlight
  data-tilt={tilt ? "true" : undefined}
  data-r
>
  <span class="font-mono text-[11px] leading-[1.4] tracking-[0.08em] text-mute uppercase">
    {label}
  </span>
  <h3 class="mt-2 mb-1.5 text-xl tracking-[-0.03em]">{title}</h3>
  <p class="mb-5 max-w-[380px] text-sm text-mute">{body}</p>
  <slot />
</article>
