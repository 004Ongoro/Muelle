---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  icons: ImageMetadata[];
  range: { min: number; max: number; value: number };
}

const { icons, range } = Astro.props;
---

<div class="md" data-magnify-row aria-hidden="true">
  {icons.map((icon) => <Image src={icon} alt="" width={range.value} height={range.value} />)}
</div>

<div class="mt-3.5 flex items-baseline justify-between">
  <label
    class="font-mono text-[11px] leading-[1.4] tracking-[0.08em] text-mute uppercase"
    for="icon-size">Icon size</label
  >
  <output
    class="font-mono text-[11px] leading-[1.4] tracking-[0.08em] text-mute uppercase tabular-nums"
    for="icon-size"
    data-magnify-value>{range.value} px</output
  >
</div>

<input
  class="range"
  id="icon-size"
  type="range"
  min={range.min}
  max={range.max}
  value={range.value}
  data-magnify-range
/>
