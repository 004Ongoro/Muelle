---
import CopyButton from "@/components/ui/CopyButton.astro";
import type { TerminalRow } from "@/data/install";

interface Props {
  rows: TerminalRow[];
}

const { rows } = Astro.props;
---

<ol class="term-rows">
  {
    rows.map((row, index) => (
      <li>
        <span class="num" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        {row.command ? (
          <>
            <code>{row.text}</code>
            <CopyButton value={row.text} />
          </>
        ) : (
          <p>{row.text}</p>
        )}
      </li>
    ))
  }
</ol>
