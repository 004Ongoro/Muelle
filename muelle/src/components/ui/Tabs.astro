---
import Terminal from "@/components/ui/Terminal.astro";
import type { InstallTab } from "@/data/install";

interface Props {
  tabs: InstallTab[];
  label: string;
}

const { tabs, label } = Astro.props;
---

<div class="inst" data-tabs>
  <div class="tabs" role="tablist" aria-label={label}>
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`panel-${tab.id}`}
          tabindex={index === 0 ? 0 : -1}
          data-tab
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  {
    tabs.map((tab, index) => (
      <div
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        class="term"
        hidden={index !== 0}
        data-panel
      >
        <Terminal rows={tab.rows} />
      </div>
    ))
  }
</div>
