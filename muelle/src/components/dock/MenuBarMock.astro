---
import Icon from "@/components/ui/Icon.astro";
import MenuBarStatus from "@/components/dock/MenuBarStatus.astro";
---

<div class="menu-bar" aria-hidden="true">
  <span class="flex items-center gap-2">
    <Icon name="anchor" size={13} />
    <b>Notes</b>
  </span>
  <span class="flex items-center gap-2 sm:gap-3">
    <MenuBarStatus />
    <span class="hidden sm:inline" data-date>Fri, Nov 14</span>
    <span class="tabular-nums" data-clock>9:41</span>
  </span>
</div>

<script>
  import { initClock } from "@/scripts/clock";

  initClock();
</script>
