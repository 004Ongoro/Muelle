---
import Section from "@/components/layout/Section.astro";
import Tabs from "@/components/ui/Tabs.astro";
import { install, installTabs } from "@/data/install";
import "@/styles/install.css";
---

<Section id="install">
  <header
    class="flex flex-col items-start gap-6 border-t border-line pt-3.5 pb-10 min-[900px]:flex-row min-[900px]:items-end min-[900px]:justify-between"
    data-r
  >
    <h2 class="text-[clamp(2.125rem,4.6vw,3.75rem)]">
      {install.heading}
      <span class="block bg-gradient-to-r from-neutral-600 via-neutral-400 to-white bg-clip-text text-transparent">
        {install.headingAccent}
      </span>
    </h2>
    <span class="font-mono text-[11px] leading-[1.4] tracking-[0.08em] text-mute uppercase">
      {install.eyebrow}
    </span>
  </header>

  <div data-r>
    <Tabs tabs={installTabs} label="Install methods" />
  </div>
</Section>

<script>
  import { initCopy } from "@/scripts/copy";
  import { initReveal } from "@/scripts/reveal";
  import { initTabs } from "@/scripts/tabs";

  const section = document.querySelector<HTMLElement>("#install");
  if (section) {
    initReveal(section);
    initTabs(section);
    initCopy(section);
  }
</script>
