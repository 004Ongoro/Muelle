---
import WindowMock from "@/components/dock/WindowMock.astro";
import Section from "@/components/layout/Section.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import StatStrip from "@/components/ui/StatStrip.astro";
import { site } from "@/data/site";
---

<Section id="top" spacing={false} class="pt-32 text-center">
  <span class="font-mono text-[11px] tracking-[0.08em] text-mute uppercase">
    Open source · MIT · Rust
  </span>

  <h1 class="mt-[18px] text-[clamp(2.75rem,7.4vw,6rem)]">
    <span class="inline-flex items-center gap-[0.14em]">
      Your Dock
      <Badge class="size-[1.05em] rotate-[-8deg] text-[0.9em]">
        <Icon name="anchor" size={20} class="size-[0.72em]" />
      </Badge>
    </span>
    <span class="block text-dim">now on Windows.</span>
  </h1>

  <p class="mx-auto mt-[22px] mb-[30px] max-w-[560px] text-lg text-mute">
    Muelle swaps the taskbar for a glass dock that magnifies, bounces and genies. Crash it, and
    Windows gets its taskbar back in under two seconds.
  </p>

  <div class="flex flex-wrap justify-center gap-3">
    <Button href={site.releases}>
      Download for Windows
      <Icon name="arrow-right" size={18} />
    </Button>
    <Button href="#how" variant="secondary">See how it works</Button>
  </div>

  <div class="mt-14">
    <WindowMock />
  </div>

  <StatStrip class="mt-12" />
</Section>
